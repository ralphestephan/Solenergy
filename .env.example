# Solenergy site — environment variables
#
# Copy this file to `.env.local` for local development. Set the same vars in
# the Vercel dashboard (Settings -> Environment Variables) for Production,
# Preview, and Development.
#
# NEVER commit real values. `.env.local` and `.env.*` are gitignored; only
# this `.env.example` is tracked.
#
# EVERY VARIABLE BELOW IS OPTIONAL AT RUNTIME. Nothing throws on a missing one:
# each leg of the submission pipeline reports its own state instead ("skipped"
# for the Prisma backup, "unconfigured" for the BDI mirror, "off" for email), and
# the form routes still answer 200 with an honest `success`. That is deliberate —
# a route that hard-failed on a missing variable would take the live contact form
# down on the deploy that introduced it.

# ---------------------------------------------------------------------------
# Supabase — BDI platform project (the CRM / system of record)
# ---------------------------------------------------------------------------
# Project URL. Find it at: Supabase dashboard -> Project Settings -> API.
# Also the base for the `website-public-submit` edge function that /api/contact
# and /api/newsletter mirror into.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Publishable / anon key. Public by design — it is shipped to the browser — but
# it is read from env and never inlined in source: this repo is PUBLIC, and
# commit 035c49a ("fix(security): rotate prod creds to env vars") removed exactly
# these literals once already.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-publishable-key>

# BDI / MemberFlow organization UUID for the Solenergy tenant. Find it in the
# BDI admin (Organizations -> Solenergy -> id) or by querying:
#   select id from organizations where slug = 'solenergy';
NEXT_PUBLIC_BDI_ORGANIZATION_ID=<solenergy-organization-uuid>

# Same value, read server-side. Every Prisma row and every mirrored submission is
# tagged with it. If it is unset the Prisma backup is SKIPPED rather than written
# untagged — an untagged row in this shared multi-tenant table belongs to nobody.
BDI_ORGANIZATION_ID=<solenergy-organization-uuid>

# ---------------------------------------------------------------------------
# Prisma — the PERMANENT backup leg
# ---------------------------------------------------------------------------
# The shared BDI/Vercel Postgres. Both were already set on the Vercel project
# but nothing read them: the repo had no prisma/ directory and no
# @prisma/client import, so this org had ZERO rows in every table.
# Without DATABASE_URL the backup leg reports "skipped" and the site still runs.
DATABASE_URL=<prisma-postgres-connection-string>
DIRECT_URL=<prisma-postgres-direct-connection-string>

# ---------------------------------------------------------------------------
# Optional / brand
# ---------------------------------------------------------------------------
# Display name used by the brand header / SEO defaults.
NEXT_PUBLIC_BRAND_NAME=Solenergy

# ---------------------------------------------------------------------------
# Email — DORMANT. Read lib/submission.ts before arming any of this.
# ---------------------------------------------------------------------------
# Solenergy's BDI delivery flags are all EIGHT ON, which means **BDI sends** the
# contact and newsletter mail today. Arming this site as well produces two
# confirmations per enquirer from two different senders until the BDI flags are
# turned off — and the flags must be turned off LAST, after a real Resend message
# id has been seen for both the customer and the owner copy.

# Rotate at https://resend.com/api-keys. A key ALONE does not arm sending.
RESEND_API_KEY=<your-resend-api-key>

# The only switch that arms it. Must be exactly "1".
SITE_SENDS_EMAIL=

# From: header. Must be a Solenergy address on a Solenergy-verified domain.
# ⚠ On the Vercel project this currently reads "BDI Tenants <info@bdicorporate.com>"
# because BDI's provision-tenant wrote it. Arming without changing it would send
# Solenergy's mail as BDI.
RESEND_FROM=<Solenergy <info@solenergypower.com>>

# Where owner notifications go. There is deliberately NO fallback to ADMIN_EMAIL:
# provision-tenant writes ADMIN_EMAIL = the platform From address, and on this
# project it too reads "BDI Tenants <info@bdicorporate.com>" — so honouring it
# would silently mail every Solenergy lead to BDI's inbox, with a real message id
# coming back, and the cutover check would still have "passed".
OWNER_EMAIL=<owner@solenergypower.com>

# Reply-To on outbound mail. Defaults to SITE.contact.email from lib/site.ts.
RESEND_REPLY_TO=

# ---------------------------------------------------------------------------
# Timeouts (optional, defaults in lib/submission.ts)
# ---------------------------------------------------------------------------
# Node's fetch has no default response timeout; without a bound, a slow upstream
# turns a stored lead into a 504 in the visitor's browser.
BDI_MIRROR_TIMEOUT_MS=6000
RESEND_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# REMOVED
# ---------------------------------------------------------------------------
# BDI_API_BASE is no longer read by this repo. It pointed at
# https://systems.bdicorporate.com — the MemberFlow SPA, which has no
# /api/contact route and answers POST with 405 — and the old proxy relayed that
# 405 to the browser as a failure. Submissions now go to the Supabase edge
# function `website-public-submit` instead, which reads organizationId off the
# body and never substitutes a default tenant. The variable can be deleted from
# the Vercel project; leaving it set is inert.
