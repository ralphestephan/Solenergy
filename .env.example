# Solenergy site — environment variables
#
# Copy this file to `.env.local` for local development. Set the same vars in
# the Vercel dashboard (Settings -> Environment Variables) for Production,
# Preview, and Development.
#
# NEVER commit real values. `.env.local` and `.env.*` are gitignored; only
# this `.env.example` is tracked.

# ---------------------------------------------------------------------------
# Supabase — Solenergy / BDI shared project
# ---------------------------------------------------------------------------
# Project URL. Find it at: Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Anon (public) JWT. Safe to expose in the browser ONLY when row-level
# security is enabled on every table reachable with this key. Rotate via
# Supabase dashboard -> Project Settings -> API -> "Rotate anon key".
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-jwt>

# BDI / MemberFlow organization UUID for the Solenergy tenant. Find it in the
# BDI admin (Organizations -> Solenergy -> id) or by querying:
#   select id from organizations where slug = 'solenergy';
NEXT_PUBLIC_BDI_ORGANIZATION_ID=<solenergy-organization-uuid>

# ---------------------------------------------------------------------------
# BDI central submissions API (used by /api/contact and /api/newsletter)
# ---------------------------------------------------------------------------
# Base URL of the BDI submissions API that owns the DB write + email send.
BDI_API_BASE=https://bdicorporate.com

# Same value as NEXT_PUBLIC_BDI_ORGANIZATION_ID but read server-side. Kept
# separate so the proxy never depends on a public-prefixed var at runtime.
BDI_ORGANIZATION_ID=<solenergy-organization-uuid>

# ---------------------------------------------------------------------------
# Optional / brand
# ---------------------------------------------------------------------------
# Display name used by the brand header / SEO defaults.
NEXT_PUBLIC_BRAND_NAME=Solenergy Power

# Resend API key — used directly only if the site ever falls back to local
# email sending. The default flow proxies through BDI, which holds the key
# server-side. Rotate at https://resend.com/api-keys.
RESEND_API_KEY=<your-resend-api-key>
