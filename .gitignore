# Node / package managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
.pnp.cjs
.pnp.loader.mjs

# Next.js
.next/
.next.cache/
out/

# Vercel
.vercel/

# Env & secrets (keep an example file instead)
.env
.env.*
!.env.example

# OS cruft
.DS_Store
Thumbs.db

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Tests / coverage (if any)
coverage/

# TypeScript build cache
*.tsbuildinfo

# Prisma (commit schema & migrations; ignore accidental local DBs)
prisma/*.db
prisma/*.db-journal

# Next.js 16 writes these on every `next dev` ("Generated AGENTS.md and
# CLAUDE.md for AI agents"). They are build artefacts of the dev server, not
# authored files, and they showed up untracked the first time this repo was run
# locally after the Next 16 upgrade.
/AGENTS.md
/CLAUDE.md
.vercel
.env*
